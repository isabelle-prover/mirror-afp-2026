section \<open>Cyclotomic and Kummer extensions have abelian Galois groups\<close>

theory Cyclotomic_Kummer
  imports "HOL-Analysis.Complex_Transcendental" 
    "HOL-New_Algebra.Subfield"
    "HOL-New_Algebra.Galois_Degree"
begin
section \<open>Roots of unity form a cyclic group\<close>

text \<open>For the complex numbers there is an \<^emph>\<open>explicit\<close> primitive @{term n}th root of unity,
  @{term "unity_root n = exp (2 * pi * \<i> / n)"}, and every @{term n}th root of unity is one of its
  powers.  Thus the group of @{term n}th roots of unity is \<^emph>\<open>cyclic\<close>, generated by @{term "unity_root n"}.\<close>

subsection \<open>The set of \<open>n\<close>th roots of unity\<close>

definition roots_of_unity :: "nat \<Rightarrow> complex set"
  where "roots_of_unity n \<equiv> {z. z ^ n = 1}"

text \<open>A distinguished primitive @{term n}th root of unity.\<close>
definition unity_root :: "nat \<Rightarrow> complex"
  where "unity_root n \<equiv> exp (2 * of_real pi * \<i> / of_nat n)"

lemma roots_of_unity_iff [simp]: "z \<in> roots_of_unity n \<longleftrightarrow> z ^ n = 1"
  by (simp add: roots_of_unity_def)

lemma one_in_roots_of_unity [simp, intro]: "1 \<in> roots_of_unity n"
  by simp

lemma finite_roots_of_unity:
  assumes "n > 0" shows "finite (roots_of_unity n)"
  unfolding roots_of_unity_def using assms by (intro finite_roots_unity) simp

lemma card_roots_of_unity:
  assumes "n > 0" shows "card (roots_of_unity n) = n"
  unfolding roots_of_unity_def using assms by (simp add: card_complex_roots_unity)

subsection \<open>The primitive root generates: powers exhaust the roots of unity\<close>

text \<open>The @{term j}th power of @{term "unity_root n"} is \<open>exp (2\<pi>\<i>j / n)\<close>, the standard
  parametrisation of the @{term n}th roots of unity.\<close>
lemma unity_root_power:
  "unity_root n ^ j = exp (2 * of_real pi * \<i> * of_nat j / of_nat n)"
  by (metis exp_of_nat2_mult times_divide_eq_left unity_root_def)

text \<open>Each power of the primitive root is indeed an @{term n}th root of unity.\<close>
lemma unity_root_pow_mem:
  assumes "n > 0" shows "unity_root n ^ j \<in> roots_of_unity n"
  by (simp add: assms complex_root_unity unity_root_power)

text \<open>\<^emph>\<open>Cyclicity.\<close>  The @{term n}th roots of unity are exactly the powers
  @{term "{unity_root n ^ j | j. j < n}"} of the primitive root: the group is cyclic.\<close>
theorem roots_of_unity_eq_powers:
  assumes "n > 0"
  shows "roots_of_unity n = {unity_root n ^ j | j. j < n}"
  using assms complex_roots_unity roots_of_unity_def unity_root_power by auto

corollary roots_of_unity_subset_powers:
  assumes "n > 0" and "z \<in> roots_of_unity n"
  shows "\<exists>j < n. z = unity_root n ^ j"
  using assms roots_of_unity_eq_powers by blast

subsection \<open>Closure properties: a subgroup of the multiplicative group\<close>

lemma unity_root_mem [simp, intro]:
  assumes "n > 0" shows "unity_root n \<in> roots_of_unity n"
  using unity_root_pow_mem[OF assms, of 1] by simp

lemma roots_of_unity_mult_closed:
  assumes "x \<in> roots_of_unity n" and "y \<in> roots_of_unity n"
  shows "x * y \<in> roots_of_unity n"
  using assms by (simp add: power_mult_distrib)

lemma roots_of_unity_nonzero:
  assumes "n > 0" and "z \<in> roots_of_unity n" shows "z \<noteq> 0"
  by (metis assms roots_of_unity_iff zero_neq_one zero_power)

lemma roots_of_unity_inverse_closed:
  assumes "z \<in> roots_of_unity n" shows "inverse z \<in> roots_of_unity n"
  by (metis assms inverse_1 power_inverse roots_of_unity_iff)

subsection \<open>Divisibility: fewer roots of unity sit among more\<close>

text \<open>If @{term n} divides @{term N} then every @{term n}th root of unity is an @{term N}th root of
  unity: from \<open>z ^ n = 1\<close> and \<open>N = n * k\<close> we get \<open>z ^ N = (z ^ n) ^ k = 1\<close>.
  Hence one primitive @{term N}th root of unity supplies the roots of unity for every exponent
  dividing @{term N} --- the fact that lets a single cyclotomic step serve a whole radical tower.\<close>
lemma roots_of_unity_dvd_mono:
  fixes z :: complex
  assumes dvd: "n dvd N" and z: "z ^ n = 1"
  shows "z ^ N = 1"
  by (metis dvd dvdE power_mult power_one z)

corollary roots_of_unity_subset_dvd:
  assumes "n dvd N"
  shows "roots_of_unity n \<subseteq> roots_of_unity N"
  using assms roots_of_unity_dvd_mono by (auto simp: roots_of_unity_def)

section \<open>Cyclotomic and Kummer extensions have abelian Galois groups\<close>

text \<open>Both the cyclotomic extension \<open>F(\<zeta>)\<close> (adjoining a primitive root
  of unity) and the Kummer extension \<open>F(a)\<close> with \<open>a\<^sup>n \<in> F\<close> and the \<open>n\<close>th roots of unity already in
  \<open>F\<close> have \<^emph>\<open>abelian\<close> Galois groups, hence \<^emph>\<open>solvable\<close> ones.  Both follow from one criterion: the
  Galois group of a simple normal extension is abelian as soon as its automorphisms commute on the
  generator, and an @{term F}-automorphism of @{term "F(a)"} is determined by its value at @{term a}.''\<close>

subsection \<open>Automorphisms map the carrier into itself\<close>

text \<open>An @{term F}-automorphism of @{term "eval_img F a"} keeps its value at @{term a} inside the
  carrier (it is extensional into @{term "eval_img F a"}).\<close>
lemma field_auto_gen_closed:
  fixes F :: "complex set" and a :: complex
  assumes "Subfield F" "\<sigma> \<in> field_auto (eval_img F a) F"
  shows "\<sigma> a \<in> eval_img F a"
  using Subfield.eval_img_self field_auto_closed assms by blast

subsection \<open>Abelian criterion for a simple normal extension\<close>

text \<open>If any two @{term F}-automorphisms of @{term "eval_img F a"} commute at the generator
  @{term a}, then @{term "field_auto (eval_img F a) F"} is an abelian group.  Determinacy
  (@{thm [source] field_auto_determined_by_gen}) upgrades commutation at @{term a} to full
  commutation, since both @{term "compose E \<sigma> \<tau>"} and @{term "compose E \<tau> \<sigma>"} are automorphisms
  agreeing at @{term a}.\<close>
lemma galois_abelian_of_gen_commute:
  fixes F :: "complex set" and a :: complex
  assumes sfF: "Subfield F" and alg: "algebraic_over F a"
    and comm_gen: "\<And>\<sigma> \<tau>. \<sigma> \<in> field_auto (eval_img F a) F \<Longrightarrow> \<tau> \<in> field_auto (eval_img F a) F
                    \<Longrightarrow> \<sigma> (\<tau> a) = \<tau> (\<sigma> a)"
  shows "Abelian_Group (field_auto (eval_img F a) F) (compose (eval_img F a)) (identity (eval_img F a))"
proof -
  let ?E = "eval_img F a"
  have sfE: "Subfield ?E" by (rule Subfield.subfield_eval_img[OF sfF alg])
  have cE: "complex_subfield ?E" using sfE by (simp add: complex_subfield_iff_subfield)
  have FE: "F \<subseteq> ?E" using Subfield.eval_img_base[OF sfF] by blast
  have aE: "a \<in> ?E" by (rule Subfield.eval_img_self[OF sfF])
  interpret G: Group "field_auto ?E F" "compose ?E" "identity ?E"
    by (rule Galois_group_Group[OF cE FE])
  \<comment> \<open>Commutativity of the group, obtained from commutation at @{term a} via determinacy.\<close>
  have comm: "compose ?E \<sigma> \<tau> = compose ?E \<tau> \<sigma>"
    if s: "\<sigma> \<in> field_auto ?E F" and t: "\<tau> \<in> field_auto ?E F" for \<sigma> \<tau>
  proof -
    obtain st: "compose ?E \<sigma> \<tau> \<in> field_auto ?E F" and ts: "compose ?E \<tau> \<sigma> \<in> field_auto ?E F"
      using s t by blast
    \<comment> \<open>Both composites send @{term a} to the same value.\<close>
    have "compose ?E \<sigma> \<tau> a = \<sigma> (\<tau> a)" using aE by (simp add: compose_eq)
    also have "\<dots> = \<tau> (\<sigma> a)" using comm_gen[OF s t] .
    also have "\<dots> = compose ?E \<tau> \<sigma> a" using aE by (simp add: compose_eq)
    finally have "compose ?E \<sigma> \<tau> a = compose ?E \<tau> \<sigma> a" .
    then show ?thesis
      by (rule field_auto_determined_by_gen[OF sfF alg st ts])
  qed
  have cm: "commutative_monoid (field_auto ?E F) (compose ?E) (identity ?E)"
    using G.Monoid_axioms comm
    by (simp add: commutative_monoid_def commutative_monoid_axioms_def)
  show ?thesis
    by (rule Abelian_Group.intro[OF G.Group_axioms cm])
qed

text \<open>Consequently such a Galois group is \<^emph>\<open>solvable\<close>.\<close>
theorem galois_solvable_of_gen_commute:
  fixes F :: "complex set" and a :: complex
  assumes sfF: "Subfield F" and alg: "algebraic_over F a"
    and comm_gen: "\<And>\<sigma> \<tau>. \<sigma> \<in> field_auto (eval_img F a) F \<Longrightarrow> \<tau> \<in> field_auto (eval_img F a) F
                    \<Longrightarrow> \<sigma> (\<tau> a) = \<tau> (\<sigma> a)"
  shows "Group.solvable (field_auto (eval_img F a) F) (compose (eval_img F a)) (identity (eval_img F a))"
proof -
  interpret AB: Abelian_Group "field_auto (eval_img F a) F"
                              "compose (eval_img F a)" "identity (eval_img F a)"
    by (simp add: alg comm_gen galois_abelian_of_gen_commute sfF)
  show ?thesis
    using AB.abelian_imp_solvable AB.commutative_monoid_axioms by blast
qed

subsection \<open>Cyclotomic extensions are abelian\<close>

text \<open>The polynomial \<open>X\<^sup>n - 1\<close> over @{term F}, and the fact that an automorphism sends an \<open>n\<close>th root
  of unity to an \<open>n\<close>th root of unity.\<close>
lemma field_auto_maps_unity_root:
  fixes F :: "complex set" and z :: complex
  assumes sfF: "Subfield F" and n: "n > 0" and alg: "algebraic_over F z"
    and s: "\<sigma> \<in> field_auto (eval_img F z) F" and root: "z ^ n = 1"
  shows "(\<sigma> z) ^ n = 1"
proof -
  let ?E = "eval_img F z"
  have sfE: "Subfield ?E" by (rule Subfield.subfield_eval_img[OF sfF alg])
  have FE: "F \<subseteq> ?E" using Subfield.eval_img_base[OF sfF] by blast
  have zE: "z \<in> ?E" by (rule Subfield.eval_img_self[OF sfF])
  define P where "P \<equiv> (monom 1 n - 1 :: complex poly)"
  have PF: "P \<in> poly_over F"
    by (simp add: P_def sfF Subfield.one_closed Subfield.poly_over_1 Subfield.poly_over_diff
        Subfield.poly_over_monom)
  have "poly P x = x ^ n - 1" for x by (simp add: P_def poly_monom)
  then show ?thesis 
    using field_auto_maps_root[OF sfE sfF FE s PF zE] root by simp
    qed

text \<open>\<^emph>\<open>Cyclotomic case.\<close>  If @{term \<zeta>} is a \<^emph>\<open>primitive\<close> @{term n}th root of unity --- every \<open>n\<close>th
  root of unity is a power of it --- then @{term "F(\<zeta>)"} has an abelian Galois group: each
  automorphism sends @{term \<zeta>} to a power @{term "\<zeta> ^ k"}, and powers commute.\<close>
theorem cyclotomic_galois_solvable:
  fixes F :: "complex set" and \<zeta> :: complex
  assumes sfF: "Subfield F" and n: "n > 0" and alg: "algebraic_over F \<zeta>"
    and root: "\<zeta> ^ n = 1"
    and primitive: "\<And>w. w ^ n = 1 \<Longrightarrow> \<exists>k. w = \<zeta> ^ k"
  shows "Group.solvable (field_auto (eval_img F \<zeta>) F) (compose (eval_img F \<zeta>)) (identity (eval_img F \<zeta>))"
proof (rule galois_solvable_of_gen_commute[OF sfF alg])
  fix \<sigma> \<tau> assume s: "\<sigma> \<in> field_auto (eval_img F \<zeta>) F" and t: "\<tau> \<in> field_auto (eval_img F \<zeta>) F"
  have sfE: "Subfield (eval_img F \<zeta>)" by (rule Subfield.subfield_eval_img[OF sfF alg])
  then obtain homs: "field_hom_on (eval_img F \<zeta>) \<sigma>" and homt: "field_hom_on (eval_img F \<zeta>) \<tau>"
    using field_auto_imp_field_hom_on s t by blast
  have zE: "\<zeta> \<in> eval_img F \<zeta>" by (rule Subfield.eval_img_self[OF sfF])
  \<comment> \<open>Each automorphism sends @{term \<zeta>} to a power of @{term \<zeta>}.\<close>
  have "(\<sigma> \<zeta>) ^ n = 1" by (rule field_auto_maps_unity_root[OF sfF n alg s root])
  then obtain k l where sk: "\<sigma> \<zeta> = \<zeta> ^ k" and tl: "\<tau> \<zeta> = \<zeta> ^ l"
    using alg field_auto_maps_unity_root n primitive root sfF t by presburger
  \<comment> \<open>Powers commute: both composites give @{term "\<zeta> ^ (k * l)"}.\<close>
  have "\<sigma> (\<tau> \<zeta>) = (\<sigma> \<zeta>) ^ l" using zE
    using field_hom_on.hom_power homs tl by auto
  also have "\<dots> = (\<zeta> ^ l) ^ k" 
    by (metis mult.commute power_mult sk)
  also have "\<dots> = \<tau> (\<sigma> \<zeta>)"
    using field_hom_on.hom_power homt sk tl zE by fastforce
  finally show "\<sigma> (\<tau> \<zeta>) = \<tau> (\<sigma> \<zeta>)" .
qed

subsection \<open>Kummer extensions are abelian\<close>

text \<open>\<^emph>\<open>Kummer case.\<close>  If @{term F} already contains the \<open>n\<close>th roots of unity and @{term "a ^ n \<in> F"},
  then @{term "F(a)"} has an abelian Galois group.  An automorphism sends @{term a} to another root
  of \<open>X\<^sup>n - a\<^sup>n\<close>, so @{term "\<sigma> a = a * (\<sigma> a / a)"} where the ratio @{term "\<sigma> a / a"} is an \<open>n\<close>th root
  of unity, hence lies in @{term F} and is fixed by every automorphism.  Two such automorphisms
  therefore commute at @{term a}.\<close>
theorem kummer_galois_solvable:
  fixes F :: "complex set" and a :: complex
  assumes sfF: "Subfield F" and n: "n > 0" and alg: "algebraic_over F a"
    and anF: "a ^ n \<in> F"
    and roots_in_F: "\<And>w. w ^ n = 1 \<Longrightarrow> w \<in> F"
    and a_nz: "a \<noteq> 0"
  shows "Group.solvable (field_auto (eval_img F a) F) (compose (eval_img F a)) (identity (eval_img F a))"
proof (rule galois_solvable_of_gen_commute[OF sfF alg])
  fix \<sigma> \<tau> assume s: "\<sigma> \<in> field_auto (eval_img F a) F" and t: "\<tau> \<in> field_auto (eval_img F a) F"
  let ?E = "eval_img F a"
  have sfE: "Subfield ?E" by (rule Subfield.subfield_eval_img[OF sfF alg])
  have FE: "F \<subseteq> ?E" using Subfield.eval_img_base[OF sfF] by blast
  have aE: "a \<in> ?E" by (rule Subfield.eval_img_self[OF sfF])
  obtain homs: "field_hom_on ?E \<sigma>" and homt: "field_hom_on ?E \<tau>"
    using field_auto_imp_field_hom_on s sfE t by blast
  have fixFs: "\<And>x. x \<in> F \<Longrightarrow> \<sigma> x = x" and fixFt: "\<And>x. x \<in> F \<Longrightarrow> \<tau> x = x"
    using s t by (auto simp: field_auto_mem_iff)
  \<comment> \<open>An automorphism preserves \<open>X\<^sup>n - a\<^sup>n\<close>, so \<open>(\<sigma> a)\<^sup>n = a\<^sup>n\<close>; the ratio is a root of unity in @{term F}.\<close>
  define P where "P \<equiv> (monom 1 n - [:a ^ n:] :: complex poly)"
  have PF: "P \<in> poly_over F"
    unfolding P_def
    by (intro Subfield.poly_over_diff[OF sfF] Subfield.poly_over_monom[OF sfF]
        Subfield.poly_over_pCons[OF sfF] Subfield.poly_over_0[OF sfF]
        Subfield.one_closed[OF sfF] anF)
  have polyP: "poly P x = x ^ n - a ^ n" for x by (simp add: P_def poly_monom)
  have Proot: "poly P a = 0" by (simp add: polyP)
  \<comment> \<open>The ratio \<open>\<mu> a / a\<close> for an automorphism @{term \<mu>}.\<close>
  have ratio: "\<mu> a / a \<in> F \<and> \<mu> a = a * (\<mu> a / a)" if m: "\<mu> \<in> field_auto ?E F" for \<mu>
    using field_auto_maps_root[OF sfE sfF FE m PF aE Proot]
    by (simp add: a_nz polyP power_divide roots_in_F) 
  obtain cs ct where csF: "cs \<in> F" and sa: "\<sigma> a = a * cs" and ctF: "ct \<in> F" and ta: "\<tau> a = a * ct"
    using ratio s t by blast
  \<comment> \<open>The ratios lie in @{term F}, so are fixed by both automorphisms; the composites agree at @{term a}.\<close>
  have "\<sigma> (\<tau> a) = \<sigma> a * \<sigma> ct"
    using FE aE ctF field_hom_on.hom_mult homs ta by fastforce
  also have "\<dots> = (a * cs) * ct" by (simp add: ctF fixFs sa)
  also have "\<dots> = \<tau> (a * cs)"
    using FE aE csF field_hom_on.hom_mult fixFt homt ta by fastforce
  also have "\<dots> = \<tau> (\<sigma> a)" by (simp add: sa)
  finally show "\<sigma> (\<tau> a) = \<tau> (\<sigma> a)" .
qed

end
