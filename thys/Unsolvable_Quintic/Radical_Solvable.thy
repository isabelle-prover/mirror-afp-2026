section \<open>The forward Abel--Ruffini direction: assembling the radical tower\<close>

theory Radical_Solvable
  imports Cyclotomic_Kummer 
    "HOL-New_Algebra.Normal_Closure"
    "HOL-New_Algebra.Galois_Restriction_Splitting" 
    "HOL-New_Algebra.Radical_Extension"
begin

text \<open>We assemble the pieces --- the solvable Kummer/cyclotomic steps, the stability engine
   and the tower assembly --- into ``a radical tower over a field containing
  enough roots of unity has a solvable Galois group''.\<close>

subsection \<open>A single radical step, with roots of unity present, is a full splitting field\<close>

text \<open>When @{term F} contains the @{term n}th roots of unity and @{term "a ^ n \<in> F"}, the simple
  Kummer extension @{term "eval_img F a"} already contains \<^emph>\<open>all\<close> roots of \<open>X\<^sup>n - a\<^sup>n\<close> (the others are
  \<open>\<zeta> * a\<close> for roots of unity \<open>\<zeta> \<in> F\<close>), so it \<^emph>\<open>equals\<close> the field generated by that full
  root set.\<close>
lemma kummer_step_full_root_set:
  fixes F :: "complex set" and a :: complex
  assumes sfF: "Subfield F" and n: "n > 0" and anF: "a ^ n \<in> F" and a_nz: "a \<noteq> 0"
    and roots_in_F: "\<And>w. w ^ n = 1 \<Longrightarrow> w \<in> F"
  shows "eval_img F a = generate_field (F \<union> {r. poly (monom 1 n - [:a ^ n:]) r = 0})"
proof -
  define P where "P \<equiv> (monom 1 n - [:a ^ n:] :: complex poly)"
  define X where "X \<equiv> {r. poly P r = 0}"
  have polyP: "poly P x = x ^ n - a ^ n" for x by (simp add: P_def poly_monom)
  \<comment> \<open>@{term a} is algebraic over @{term F}: it is a root of the nonzero @{term F}-polynomial @{term P}.\<close>
  have PF: "P \<in> poly_over F"
    unfolding P_def
    by (simp add: anF roots_in_F sfF Subfield.poly_over_0 Subfield.poly_over_diff
        Subfield.poly_over_monom Subfield.poly_over_pCons)
  have Pnz: "P \<noteq> 0"
    by (simp add: P_def monom_eq_const_iff n)
  have alg: "algebraic_over F a"
    using PF Pnz algebraic_over_def polyP by force
  interpret E: Subfield "eval_img F a" by (rule Subfield.subfield_eval_img[OF sfF alg])
  obtain aE: "a \<in> eval_img F a" and FE: "F \<subseteq> eval_img F a" 
    using Subfield.eval_img_base Subfield.eval_img_self sfF by blast
  \<comment> \<open>The other roots of \<open>X\<^sup>n - a\<^sup>n\<close> are @{term "w * a"} with @{term w} a root of unity in @{term F}.\<close>
  have XE: "X \<subseteq> eval_img F a"
  proof
    fix r assume "r \<in> X"
    then have rn: "r ^ n = a ^ n" by (simp add: X_def polyP)
    define w where "w = r * inverse a"
    have w: "w ^ n = 1" using a_nz
      by (metis power_mult_distrib power_one right_inverse rn w_def)
    have "r = w * a" using a_nz by (simp add: w_def field_simps)
    then show "r \<in> eval_img F a" 
      using w FE aE roots_in_F by blast
  qed
  \<comment> \<open>Two inclusions between the two generated fields.\<close>
  have aX: "a \<in> X" by (simp add: X_def polyP)
  have \<section>: "eval_img F a = generate_field (F \<union> {a})"
    by (rule Subfield.eval_img_eq_generate_field[OF sfF alg])
  have "generate_field (F \<union> {a}) = generate_field (F \<union> X)"
  proof 
    show "generate_field (F \<union> {a}) \<subseteq> generate_field (F \<union> X)"
      by (simp add: aX generate_field_mono)
    show "generate_field (F \<union> X) \<subseteq> generate_field (F \<union> {a})"
      by (metis E.Subfield_axioms FE Un_least XE \<section> generate_field_least)
  qed
  with \<section> show ?thesis by (simp add: P_def X_def)
qed

subsection \<open>A Kummer step is both solvable and stable\<close>

text \<open>Packaging the previous facts: inside an ambient field @{term K} that contains the full root set
  of \<open>X\<^sup>n - a\<^sup>n\<close>, and with the @{term n}th roots of unity present in @{term F}, the Kummer extension
  @{term "eval_img F a"} supplies \<^emph>\<open>both\<close> ingredients that @{const solvable_tower} needs for a step:
  its relative Galois group is solvable (@{thm [source] kummer_galois_solvable}), and it is stable
  under @{term "field_auto K F"} (@{thm [source] root_generated_stable}, since it is a full
  root-set field by @{thm [source] kummer_step_full_root_set}).\<close>
theorem kummer_step_solvable_and_stable:
  fixes K F :: "complex set" and a :: complex
  assumes K: "Subfield K" and sfF: "Subfield F" and FK: "F \<subseteq> K"
    and n: "n > 0" and anF: "a ^ n \<in> F" and a_nz: "a \<noteq> 0"
    and roots_in_F: "\<And>w. w ^ n = 1 \<Longrightarrow> w \<in> F"
    and aK: "a \<in> K"
  shows "Group.solvable (field_auto (eval_img F a) F) (compose (eval_img F a)) (identity (eval_img F a))
       \<and> eval_img F a \<subseteq> K
       \<and> (\<forall>\<sigma> \<in> field_auto K F. \<sigma> ` eval_img F a = eval_img F a)
       \<and> Subfield (eval_img F a)"
proof -
  define P where "P \<equiv> (monom 1 n - [:a ^ n:])"
  define X where "X \<equiv> {r. poly P r = 0}"
  have polyP: "poly P x = x ^ n - a ^ n" for x by (simp add: P_def poly_monom)
  have PF: "P \<in> poly_over F"
    unfolding P_def
    by (metis anF monom_0 sfF Subfield.one_closed Subfield.poly_over_diff
        Subfield.poly_over_monom)
  have Pnz: "P \<noteq> 0"
    by (simp add: P_def monom_eq_const_iff n)
  have alg: "algebraic_over F a"
    unfolding algebraic_over_def using PF Pnz by (auto simp: polyP)
  \<comment> \<open>The Kummer extension equals the full-root-set field of \<open>P\<close>.\<close>
  have E_eq: "eval_img F a = generate_field (F \<union> X)"
    using kummer_step_full_root_set[OF sfF n anF a_nz roots_in_F] by (simp add: P_def X_def)
  have solv: "Group.solvable (field_auto (eval_img F a) F)
                (compose (eval_img F a)) (identity (eval_img F a))"
    by (rule kummer_galois_solvable[OF sfF n alg anF roots_in_F a_nz])
  have finX: "finite X" unfolding X_def using Pnz by (rule poly_roots_finite)
  have XK: "X \<subseteq> K"
  proof
    fix r assume "r \<in> X"
    then have rn: "r ^ n = a ^ n" by (simp add: X_def polyP)
    define w where "w \<equiv> r * inverse a"
    have "w ^ n = 1"
      by (simp add: a_nz power_inverse power_mult_distrib rn w_def)
    with FK have wK: "w \<in> K"
      by (simp add: roots_in_F subsetD)
    have "r = w * a" using a_nz by (simp add: w_def field_simps)
    then show "r \<in> K" using wK aK K by (simp add: Subfield.mult_closed)
  qed
  have EK: "eval_img F a \<subseteq> K"
    unfolding E_eq using FK XK by (intro generate_field_least[OF K]) simp
  \<comment> \<open>Stability under @{term "field_auto K F"}.\<close>
  have stable: "\<sigma> ` eval_img F a = eval_img F a" if s: "\<sigma> \<in> field_auto K F" for \<sigma>
    unfolding E_eq
    by (metis FK K PF XK X_def finX root_generated_stable sfF that)
  have sfE: "Subfield (eval_img F a)" by (rule Subfield.subfield_eval_img[OF sfF alg])
  show ?thesis using solv EK stable sfE by blast
qed

subsection \<open>A cyclotomic step is solvable, stable, and supplies the roots of unity\<close>

text \<open>Adjoining the primitive @{term n}th root of unity @{term "unity_root n"} to @{term F}: the
  extension @{term "eval_img F (unity_root n)"} has a solvable (abelian) Galois group
  (@{thm [source] cyclotomic_galois_solvable}), is the full root-set field of \<open>X\<^sup>n - 1\<close> (hence stable
  by @{thm [source] root_generated_stable}), and --- crucially --- \<^emph>\<open>contains all the @{term n}th roots
  of unity\<close>, establishing the invariant that the subsequent Kummer step needs.\<close>
theorem cyclotomic_step_solvable_and_stable:
  fixes K F :: "complex set"
  assumes K: "Subfield K" and sfF: "Subfield F" and FK: "F \<subseteq> K" and n: "n > 0"
    and zK: "unity_root n \<in> K"
  shows "Group.solvable (field_auto (eval_img F (unity_root n)) F)
             (compose (eval_img F (unity_root n))) (identity (eval_img F (unity_root n)))
       \<and> eval_img F (unity_root n) \<subseteq> K
       \<and> (\<forall>\<sigma> \<in> field_auto K F. \<sigma> ` eval_img F (unity_root n) = eval_img F (unity_root n))
       \<and> Subfield (eval_img F (unity_root n))
       \<and> (\<forall>w. w ^ n = 1 \<longrightarrow> w \<in> eval_img F (unity_root n))"
proof -
  define \<zeta> where "\<zeta> = unity_root n"
  have zroot: "\<zeta> ^ n = 1" unfolding \<zeta>_def using unity_root_mem[OF n] by simp
  \<comment> \<open>Every @{term n}th root of unity is a power of @{term \<zeta>} (primitivity).\<close>
  have primitive: "\<exists>k. w = \<zeta> ^ k" if "w ^ n = 1" for w
    using \<zeta>_def n roots_of_unity_subset_powers that by auto
  define P where "P \<equiv> (monom 1 n - 1 :: complex poly)"
  define X where "X \<equiv> {r. poly P r = 0}"
  have polyP: "poly P x = x ^ n - 1" for x by (simp add: P_def poly_monom)
  have PF: "P \<in> poly_over F"
    by (simp add: P_def sfF Subfield.one_closed Subfield.poly_over_1 Subfield.poly_over_diff
        Subfield.poly_over_monom)
  have Pnz: "P \<noteq> 0"
    by (metis n polyP poly_0 right_minus_eq zero_neq_one zero_power)
  have Xroots: "X = roots_of_unity n" by (auto simp: X_def polyP roots_of_unity_def)
  have alg: "algebraic_over F \<zeta>"
    unfolding algebraic_over_def using PF Pnz zroot by (auto simp: polyP)
  interpret E: Subfield "eval_img F \<zeta>" by (rule Subfield.subfield_eval_img[OF sfF alg])
  \<comment> \<open>All roots of unity are powers of @{term \<zeta>}, hence lie in @{term "eval_img F \<zeta>"}.\<close>
  have rootsE: "w \<in> eval_img F \<zeta>" if wn: "w ^ n = 1" for w
    using primitive wn sfF Subfield.eval_img_self by blast
  \<comment> \<open>@{term "eval_img F \<zeta>"} equals the full root-set field of @{term P}.\<close>
  have XE: "X \<subseteq> eval_img F \<zeta>" using Xroots rootsE by (auto simp: roots_of_unity_def)
  have E_eq: "eval_img F \<zeta> = generate_field (F \<union> X)"
  proof -
    have \<section>: "eval_img F \<zeta> = generate_field (F \<union> {\<zeta>})"
      by (rule Subfield.eval_img_eq_generate_field[OF sfF alg])
    moreover have "generate_field (F \<union> {\<zeta>}) = generate_field (F \<union> X)"
    proof 
      have "F \<union> {\<zeta>} \<subseteq> F \<union> X"
        by (simp add: Xroots zroot)
      then show "generate_field (F \<union> {\<zeta>}) \<subseteq> generate_field (F \<union> X)" by (rule generate_field_mono)
      have "F \<union> X \<subseteq> eval_img F \<zeta>"
        using XE sfF Subfield.eval_img_base by auto
      then show "generate_field (F \<union> X) \<subseteq> generate_field (F \<union> {\<zeta>})"
        by (metis \<section> subfield_generate_field generate_field_least)
    qed
    ultimately show ?thesis by simp
  qed
  \<comment> \<open>Containment in @{term K}: roots of unity are powers of @{term "\<zeta> \<in> K"}.\<close>
  have XK: "X \<subseteq> K"
    using K primitive Subfield.power_closed zK by (force simp: \<zeta>_def Xroots)
  have EK: "eval_img F \<zeta> \<subseteq> K"
    unfolding E_eq using FK XK by (intro generate_field_least[OF K]) simp
  have finX: "finite X"
    by (simp add: Pnz X_def poly_roots_finite)
  have stable: "\<sigma> ` eval_img F \<zeta> = eval_img F \<zeta>" if s: "\<sigma> \<in> field_auto K F" for \<sigma>
    unfolding E_eq
    using root_generated_stable[OF K sfF FK PF] XK X_def finX that by blast
  show ?thesis
    using cyclotomic_galois_solvable[OF sfF n alg zroot primitive]
    using EK stable E.Subfield_axioms rootsE by (simp add: \<zeta>_def)
qed

subsection \<open>A chain of Kummer steps is a solvable tower\<close>

text \<open>An element whose @{term n}th power lies in @{term F} is algebraic over @{term F} (it is a root
  of the nonzero @{term F}-polynomial \<open>X\<^sup>n - a\<^sup>n\<close>).\<close>
lemma radical_algebraic:
  fixes F :: "complex set"
  assumes sfF: "Subfield F" and n: "n > 0" and anF: "a ^ n \<in> F"
  shows "algebraic_over F a"
proof -
  define P where "P \<equiv> (monom 1 n - [:a ^ n:] :: complex poly)"
  have polyP: "poly P x = x ^ n - a ^ n" for x by (simp add: P_def poly_monom)
  have PF: "P \<in> poly_over F"
    by (simp add: P_def anF sfF Subfield.one_closed Subfield.poly_over_0 Subfield.poly_over_diff
        Subfield.poly_over_monom Subfield.poly_over_pCons)
  have Pnz: "P \<noteq> 0"
    by (metis n polyP poly_0 power_one right_minus_eq zero_neq_one zero_power)
  show ?thesis unfolding algebraic_over_def using PF Pnz by (auto simp: polyP)
qed

text \<open>The chain of fields built from a list of \<^emph>\<open>Kummer witnesses\<close> @{term "(a, n)"} (each contributing
  a step \<open>F \<leadsto> F(a)\<close>).\<close>
fun kummer_fields :: "complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> complex set list" where
  "kummer_fields F [] = []"
| "kummer_fields F ((a, n) # ws) = eval_img F a # kummer_fields (eval_img F a) ws"

text \<open>Validity of a witness chain over @{term F}: each step has positive exponent, a nonzero base
  @{term a} with @{term "a ^ n \<in> F"}, and the @{term n}th roots of unity already present in the
  current field.\<close>
fun kummer_valid :: "complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> bool" where
  "kummer_valid F [] = True"
| "kummer_valid F ((a, n) # ws) =
     (n > 0 \<and> a \<noteq> 0 \<and> a ^ n \<in> F \<and> (\<forall>w. w ^ n = 1 \<longrightarrow> w \<in> F) \<and>
      kummer_valid (eval_img F a) ws)"

text \<open>The top field of the chain (the ambient splitting field).\<close>
definition ktop :: "complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> complex set" where
  "ktop F ws \<equiv> last (F # kummer_fields F ws)"

lemma ktop_Nil [simp]: "ktop F [] = F"
  by (simp add: ktop_def)

lemma ktop_Cons [simp]: "ktop F ((a, n) # ws) = ktop (eval_img F a) ws"
  by (simp add: ktop_def)

text \<open>The chain is increasing, so the base is contained in the top.\<close>
lemma ktop_facts:
  fixes F :: "complex set"
  shows "Subfield F \<Longrightarrow> kummer_valid F ws \<Longrightarrow> F \<subseteq> ktop F ws \<and> Subfield (ktop F ws)"
proof (induction ws arbitrary: F)
  case (Cons w ws)
  then obtain a n where an: "w = (a, n)" and "n > 0" "a ^ n \<in> F" and valid': "kummer_valid (eval_img F a) ws"
     by (cases w) auto
  then have "Subfield (eval_img F a)"
    using Cons.prems radical_algebraic by (simp add: Subfield.subfield_eval_img)
  then show ?case using an Cons
    by (simp add: Subfield.eval_img_base subset_iff)
qed auto

text \<open>The top field is a subfield.\<close>
lemma
  assumes "Subfield F" "kummer_valid F ws"
  shows F_subset_ktop: "F \<subseteq> ktop F ws" and subfield_ktop: "Subfield (ktop F ws)"
  using ktop_facts [OF assms] by auto

text \<open>\<^emph>\<open>The chain is a solvable tower.\<close>  By induction on the witness list: each Kummer step is solvable
  and stable inside the ambient top field.\<close>
theorem kummer_chain_solvable_tower:
  "Subfield F \<Longrightarrow> kummer_valid F ws \<Longrightarrow> solvable_tower (ktop F ws) F (kummer_fields F ws)"
proof (induction ws arbitrary: F)
  case Nil
  then show ?case by simp
next
  case (Cons w ws)
  then obtain a n where an: "w = (a, n)" and n: "n > 0" and anF: "a ^ n \<in> F" and a_nz: "a \<noteq> 0"
    and rou: "\<And>w. w ^ n = 1 \<Longrightarrow> w \<in> F" and valid': "kummer_valid (eval_img F a) ws"
    by (cases w) auto
  let ?G = "eval_img F a"
  have sfF: "Subfield F" by (rule Cons.prems(1))
  have sfG: "Subfield ?G"
    using anF n radical_algebraic sfF Subfield.subfield_eval_img by blast
  define K where "K \<equiv> ktop ?G ws"
  have sfK: "Subfield K" unfolding K_def using subfield_ktop[OF sfG valid'] .
  have GK: "?G \<subseteq> K" unfolding K_def using F_subset_ktop[OF sfG valid'] .
  have FG: "F \<subseteq> ?G" using Subfield.eval_img_base[OF sfF] by blast
  have FK: "F \<subseteq> K" using FG GK by blast
  have aK: "a \<in> K" using Subfield.eval_img_self[OF sfF] GK by blast
  \<comment> \<open>The rest of the chain is a solvable tower, by the induction hypothesis.\<close>
  have "solvable_tower K ?G (kummer_fields ?G ws)"
    using Cons.IH[OF sfG valid'] unfolding K_def .
  \<comment> \<open>The step is solvable and stable inside @{term K}.\<close>
  then have "solvable_tower K F (?G # kummer_fields ?G ws)"
    using kummer_step_solvable_and_stable[OF sfK sfF FK n anF a_nz rou aK]
    by (simp add: FG sfF)
  then show ?case using an by (simp add: K_def)
qed

text \<open>The Galois group of a valid Kummer chain is solvable.\<close>
corollary kummer_chain_galois_solvable:
  assumes sfF: "Subfield F" and valid: "kummer_valid F ws"
  shows "Group.solvable (field_auto (ktop F ws) F) (compose (ktop F ws)) (identity (ktop F ws))"
  using kummer_chain_solvable_tower sfF solvable_tower_imp_solvable subfield_ktop valid
  by blast

subsection \<open>Solvability descends to a stable subfield with surjective restriction\<close>

text \<open>\<^emph>\<open>Descent to an intermediate Galois group.\<close>  Let \<open>F \<subseteq> E \<subseteq> K\<close> with @{term E} stable under
  @{term "field_auto K F"}, and suppose restriction @{term "\<lambda>\<sigma>. restrict \<sigma> E"} maps
  @{term "field_auto K F"} \<^emph>\<open>onto\<close> @{term "field_auto E F"} (the \<^emph>\<open>normality\<close> input: every
  @{term F}-automorphism of @{term E} extends to one of @{term K}).  Then if @{term "field_auto K F"}
  is solvable, so is @{term "field_auto E F"} --- it is a homomorphic image.

  This is the group-theoretic heart of the forward direction: the quintic's Galois group would be a
  \<^emph>\<open>quotient\<close> of the solvable Galois group of a radical extension, hence solvable --- contradicting its
  non-solvability.  The surjectivity hypothesis is exactly what \<^emph>\<open>normality of @{term K} over @{term F}\<close>
  supplies (and what a full normal-closure construction would discharge).\<close>
theorem galois_solvable_descends:
  fixes K E F :: "complex set"
  assumes K: "Subfield K" and sfE: "Subfield E" and sfF: "Subfield F"
    and FE: "F \<subseteq> E" and EK: "E \<subseteq> K"
    and stable: "\<And>\<sigma>. \<sigma> \<in> field_auto K F \<Longrightarrow> \<sigma> ` E = E"
    and onto: "(\<lambda>\<sigma>. restrict \<sigma> E) ` field_auto K F = field_auto E F"
    and solvK: "Group.solvable (field_auto K F) (compose K) (identity K)"
  shows "Group.solvable (field_auto E F) (compose E) (identity E)"
proof -
  \<comment> \<open>Restriction is a group homomorphism onto @{term "field_auto E F"} (stability + surjectivity).\<close>
  interpret H: group_homomorphism "galois_restriction K E F"
      "field_auto K F" "compose K" "identity K" "field_auto E F" "compose E" "identity E"
    by (simp add: EK FE K galois_restriction_def galois_restriction_hom sfE stable)
  have surj: "galois_restriction K E F ` field_auto K F = field_auto E F"
    using onto by (simp add: galois_restriction_def)
  interpret Epi: group_epimorphism "galois_restriction K E F"
      "field_auto K F" "compose K" "identity K" "field_auto E F" "compose E" "identity E"
    by (rule galois_restriction_epimorphism[OF K sfE FE EK stable surj])
  show ?thesis by (rule Epi.solvable_image_epi[OF solvK])
qed

subsection \<open>The forward theorem\<close>

text \<open>\<^emph>\<open>The forward Abel--Ruffini theorem.\<close>  Suppose a set @{term S} lies in a field
  @{term E} that sits inside the top @{term "ktop F ws"} of a valid Kummer chain over @{term F}
  (so @{term E} is contained in a radical extension), with @{term E} stable under the ambient Galois
  group and restriction onto @{term "field_auto E F"} surjective (the normality conditions).  Then
  @{term "field_auto E F"} is solvable.

  Chaining @{thm [source] kummer_chain_galois_solvable} (the radical top has a solvable Galois group)
  with @{thm [source] galois_solvable_descends} (solvability descends to the stable subfield).  This
  is the complete forward direction modulo the single classical input --- normality of the ambient
  radical field, i.e.\ surjectivity of restriction --- which a full normal-closure construction
  supplies.\<close>
theorem radical_extension_galois_solvable:
  fixes F E :: "complex set" and ws :: "(complex \<times> nat) list"
  assumes sfF: "Subfield F" and sfE: "Subfield E"
    and valid: "kummer_valid F ws"
    and FE: "F \<subseteq> E" and EK: "E \<subseteq> ktop F ws"
    and stable: "\<And>\<sigma>. \<sigma> \<in> field_auto (ktop F ws) F \<Longrightarrow> \<sigma> ` E = E"
    and onto: "(\<lambda>\<sigma>. restrict \<sigma> E) ` field_auto (ktop F ws) F = field_auto E F"
  shows "Group.solvable (field_auto E F) (compose E) (identity E)"
proof -
  have sfK: "Subfield (ktop F ws)" by (rule subfield_ktop[OF sfF valid])
  show ?thesis
    using galois_solvable_descends[OF sfK sfE sfF FE EK stable onto]
    using kummer_chain_galois_solvable sfF valid by blast
qed

subsection \<open>From a roots-of-unity-free chain to a valid Kummer chain\<close>

text \<open>A \<^emph>\<open>pre-Kummer chain\<close> over @{term F} bounded by @{term N}: each step has positive exponent
  @{term n} \<^emph>\<open>dividing @{term N}\<close>, a nonzero base @{term a} with @{term "a ^ n \<in> F"}.  This is the
  roots-of-unity-\<^emph>\<open>free\<close> data of a radical tower (a raw radical step, tagged with its exponent), with
  the mild global bound that all exponents divide a common @{term N}.\<close>
fun pre_kummer_valid :: "nat \<Rightarrow> complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> bool" where
  "pre_kummer_valid N F [] = True"
| "pre_kummer_valid N F ((a, n) # ws) =
     (n > 0 \<and> n dvd N \<and> a \<noteq> 0 \<and> a ^ n \<in> F \<and> pre_kummer_valid N (eval_img F a) ws)"

text \<open>If the base field already contains all @{term N}th roots of unity, a pre-Kummer chain bounded by
  @{term N} is a genuine Kummer chain: at each step the @{term n}th roots of unity (with @{term "n dvd N"})
  are among the @{term N}th roots of unity (@{thm [source] roots_of_unity_dvd_mono}), which persist up
  the tower since each field contains its predecessor.\<close>
lemma pre_kummer_valid_imp_kummer_valid:
  "Subfield F \<Longrightarrow> (\<forall>w. w ^ N = 1 \<longrightarrow> w \<in> F) \<Longrightarrow> pre_kummer_valid N F ws \<Longrightarrow> kummer_valid F ws"
proof (induction ws arbitrary: F)
  case Nil
  then show ?case by simp
next
  case (Cons w ws)
  then obtain a n where an: "w = (a, n)"
  and "n > 0" and ndvd: "n dvd N" and a_nz: "a \<noteq> 0" and anF: "a ^ n \<in> F" and pre': "pre_kummer_valid N (eval_img F a) ws"
    by (metis pre_kummer_valid.simps(2) surj_pair)
  \<comment> \<open>Each @{term n}th root of unity (\<open>n dvd N\<close>) is an @{term N}th root of unity, hence in @{term F}.\<close>
  have rou_n: "\<And>v. v ^ n = 1 \<Longrightarrow> v \<in> F"
    using ndvd roots_of_unity_dvd_mono Cons.prems by blast
  have sfG: "Subfield (eval_img F a)"
    using \<open>Subfield F\<close> anF \<open>n > 0\<close> radical_algebraic Subfield.subfield_eval_img by blast
  have FG: "F \<subseteq> eval_img F a" using Subfield.eval_img_base[OF Cons.prems(1)] by blast
  \<comment> \<open>The roots-of-unity invariant persists to the next field (it contains @{term F}).\<close>
  have "kummer_valid (eval_img F a) ws"
    using Cons FG pre' sfG by blast
  then show ?case using \<open>n > 0\<close> a_nz anF rou_n an by simp
qed

text \<open>\<^emph>\<open>The Galois group of a pre-Kummer chain, once the roots of unity are adjoined, is solvable.\<close>
  If @{term F} contains the @{term N}th roots of unity and @{term ws} is a pre-Kummer chain bounded by
  @{term N}, then @{term "field_auto (ktop F ws) F"} is solvable.\<close>
corollary pre_kummer_chain_galois_solvable:
  assumes sfF: "Subfield F" and rou: "\<forall>w. w ^ N = 1 \<longrightarrow> w \<in> F"
    and pre: "pre_kummer_valid N F ws"
  shows "Group.solvable (field_auto (ktop F ws) F) (compose (ktop F ws)) (identity (ktop F ws))"
  using kummer_chain_galois_solvable[OF sfF pre_kummer_valid_imp_kummer_valid[OF sfF rou pre]] .

subsection \<open>Extracting Kummer witnesses from a radical tower\<close>

text \<open>A \<^emph>\<open>nondegenerate\<close> radical tower is one whose every step can be realised by a \<^emph>\<open>nonzero\<close> radical
  whose exponent divides a common bound @{term N}.  (Adjoining @{term 0} adds nothing, so this is no
  real restriction for reaching a target set; and any finite family of exponents divides their common
  multiple.)  We record this as the existence of a witness list.\<close>
definition realises_tower :: "nat \<Rightarrow> complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> complex set list \<Rightarrow> bool"
  where "realises_tower N F ws Fs \<equiv> pre_kummer_valid N F ws \<and> kummer_fields F ws = Fs"

text \<open>If a radical tower is realised by a nondegenerate witness list over a base @{term F} containing
  the @{term N}th roots of unity, then its top field has a solvable Galois group over @{term F}.  The
  top field of the realised chain coincides with the tower top.\<close>
lemma ktop_eq_tower_top:
  assumes "kummer_fields F ws = Fs"
  shows "ktop F ws = tower_top F Fs"
  using assms by (simp add: ktop_def tower_top_def)

theorem radical_tower_galois_solvable:
  assumes sfF: "Subfield F" and rou: "\<forall>w. w ^ N = 1 \<longrightarrow> w \<in> F"
    and real: "realises_tower N F ws Fs"
  shows "Group.solvable (field_auto (tower_top F Fs) F)
           (compose (tower_top F Fs)) (identity (tower_top F Fs))"
proof -
  have pre: "pre_kummer_valid N F ws" and kf: "kummer_fields F ws = Fs"
    using real by (auto simp: realises_tower_def)
  then show ?thesis using ktop_eq_tower_top[OF kf]
    by (metis pre_kummer_chain_galois_solvable rou sfF)
qed

text \<open>Conversely, a nondegenerate witness chain \<^emph>\<open>is\<close> a radical tower in the sense of
  @{const radical_tower}: each Kummer step \<open>F \<leadsto> F(a)\<close> is a radical step, since
  @{term "eval_img F a = generate_field (F \<union> {a})"} with @{term "a ^ n \<in> F"}.  Thus the notion of a
  realised tower is faithful to the project's @{const radical_tower}.\<close>
subsection \<open>Extracting a nondegenerate witness list from a bare radical tower\<close>

text \<open>The nondegeneracy conditions of a witness list, without the common divisibility bound: each step
  has positive exponent, a nonzero base, and its power in the current field.\<close>
fun wit_valid :: "complex set \<Rightarrow> (complex \<times> nat) list \<Rightarrow> bool" where
  "wit_valid F [] = True"
| "wit_valid F ((a, n) # ws) =
     (n > 0 \<and> a \<noteq> 0 \<and> a ^ n \<in> F \<and> wit_valid (eval_img F a) ws)"

text \<open>Given a common bound @{term N} divisible by every step exponent, a nondegenerate witness list is
  a pre-Kummer chain.\<close>
lemma wit_valid_imp_pre_kummer_valid:
  "wit_valid F ws \<Longrightarrow> (\<forall>x \<in> set ws. snd x dvd N) \<Longrightarrow> pre_kummer_valid N F ws"
proof (induction ws arbitrary: F)
  case Nil
  then show ?case by simp
next
  case (Cons w ws) 
  then show ?case by (cases w) force
qed

text \<open>\<^emph>\<open>Every radical tower has a nondegenerate witness list.\<close>  Walking the tower: each radical step
  \<open>F \<leadsto> G\<close> either uses a nonzero radical (@{term "G = eval_img F a"}) or is a no-op (@{term "G = F"},
  which occurs when the existential witness is @{term 0}); in the latter case the trivial witness
  @{term "(1, 1)"} reproduces @{term F} (as @{term "eval_img F 1 = F"}).\<close>
lemma radical_tower_witnesses:
  "Subfield F \<Longrightarrow> radical_tower F Fs \<Longrightarrow> \<exists>ws. wit_valid F ws \<and> kummer_fields F ws = Fs"
proof (induction Fs arbitrary: F)
  case Nil
  show ?case by (rule exI[of _ "[]"]) simp
next
  case (Cons G Gs)
  interpret F: Subfield F by (rule \<open>Subfield F\<close>)
  have step: "radical_step F G" and tower': "radical_tower G Gs" using Cons.prems(2) by auto
  obtain a n where "n > 0" and anF: "a ^ n \<in> F" and Gdef: "G = generate_field (F \<union> {a})"
    using step by (auto simp: radical_step_def)
  \<comment> \<open>Either the step is a genuine nonzero adjunction, or a no-op producing @{term F} again.\<close>
  consider (nz) "a \<noteq> 0" | (z) "a = 0" by blast
  then show ?case
  proof cases
    case nz
    have sfG: "Subfield G"
      using local.step radical_step_field by auto
    obtain ws where "wit_valid G ws" "kummer_fields G ws = Gs"
      using Cons.IH[OF sfG tower'] by blast
    then show ?thesis
      using anF kummer_fields.simps(2) \<open>n > 0\<close> nz wit_valid.simps(2)
      by (metis F.eval_img_eq_generate_field F.Subfield_axioms Gdef radical_algebraic)
  next
    case z
    have "F \<union> {a} = F" using z F.zero_closed by auto
    then have GF: "G = F" using Gdef by (simp add: F.generate_field_self)
    \<comment> \<open>The trivial witness @{term "(1, 1)"} keeps the field at @{term F}.\<close>
    have alg1: "algebraic_over F 1" using radical_algebraic[OF \<open>Subfield F\<close>, of 1 1] F.one_closed by simp
    have e1: "eval_img F 1 = F"
      using Subfield.eval_img_eq_generate_field[OF \<open>Subfield F\<close> alg1] F.one_closed
      by (simp add: insert_absorb F.generate_field_self)
    obtain ws where ws: "wit_valid F ws" "kummer_fields F ws = Gs"
      using Cons.IH F.Subfield_axioms GF tower' by blast
    have "wit_valid F ((1, 1) # ws) \<and> kummer_fields F ((1, 1) # ws) = G # Gs"
      using ws e1 F.one_closed GF by simp
    then show ?thesis by blast
  qed
qed

lemma pre_kummer_valid_imp_radical_tower:
  "Subfield F \<Longrightarrow> pre_kummer_valid N F ws \<Longrightarrow> radical_tower F (kummer_fields F ws)"
proof (induction ws arbitrary: F)
  case Nil
  then show ?case by simp
next
  case (Cons w ws)
  then obtain a n where an: "w = (a, n)" and "n > 0" and anF: "a ^ n \<in> F" 
    by (metis pre_kummer_valid.simps(2) surj_pair)
  have alg: "algebraic_over F a" using radical_algebraic[OF Cons.prems(1) \<open>n > 0\<close> anF] .
  \<comment> \<open>The first step is a radical step.\<close>
  have "eval_img F a = generate_field (F \<union> {a})"
    by (rule Subfield.eval_img_eq_generate_field[OF Cons.prems(1) alg])
  then have "radical_step F (eval_img F a)"
    unfolding radical_step_def using \<open>n > 0\<close> anF by blast
  \<comment> \<open>The rest is a radical tower, by the induction hypothesis.\<close>
  then show ?case using an Cons
    using radical_step_field by auto
qed

subsection \<open>A radical tower over a roots-of-unity base has a solvable Galois group\<close>

text \<open>\<^emph>\<open>The forward theorem for a bare radical tower.\<close>  If @{term F} contains \<^emph>\<open>enough\<close> roots of unity ---
  namely the @{term N}th roots of unity for @{term N} the product of the (extracted) step exponents ---
  then the top of any radical tower over @{term F} has a solvable Galois group over @{term F}.
  This reduces the forward direction over @{term F} to the single remaining hypothesis that @{term F}
  contains the required roots of unity --- which a cyclotomic pre-step \<open>F \<leadsto> F(\<zeta>\<^sub>N)\<close> supplies (and
  which, over \<open>\<rat>\<close>, is the only reason the base must first be enlarged).\<close>
theorem radical_tower_solvable_of_roots:
  assumes sfF: "Subfield F" and tower: "radical_tower F Fs"
    and rou: "\<And>ws. wit_valid F ws \<Longrightarrow> kummer_fields F ws = Fs
                \<Longrightarrow> \<forall>w. w ^ (prod_list (List.map snd ws)) = 1 \<longrightarrow> w \<in> F"
  shows "Group.solvable (field_auto (tower_top F Fs) F)
           (compose (tower_top F Fs)) (identity (tower_top F Fs))"
proof -
  obtain ws where wv: "wit_valid F ws" and kf: "kummer_fields F ws = Fs"
    using radical_tower_witnesses[OF sfF tower] by blast
  define N where "N \<equiv> prod_list (List.map snd ws)"
  \<comment> \<open>Every step exponent divides @{term N}.\<close>
  have dvdN: "\<forall>x \<in> set ws. snd x dvd N"
    by (simp add: N_def prod_list_dvd)
  have pre: "pre_kummer_valid N F ws" by (rule wit_valid_imp_pre_kummer_valid[OF wv dvdN])
  have real: "realises_tower N F ws Fs" using pre kf by (simp add: realises_tower_def)
  have rouN: "\<forall>w. w ^ N = 1 \<longrightarrow> w \<in> F" using rou[OF wv kf] by (simp add: N_def)
  show ?thesis by (rule radical_tower_galois_solvable[OF sfF rouN real])
qed

subsection \<open>Unconditional descent to a stable splitting subfield\<close>

text \<open>Combining the splitting-field image theorem
  @{thm [source] galois_restriction_image_of_splitting_field} with the descent theorem
  @{thm [source] galois_solvable_descends} discharges the former surjectivity obligation when
  @{term K} is a splitting field over @{term E}. This is where the ``deep gap'' closes.\<close>
theorem galois_splitting_subfield_solvable:
  fixes K E F :: "complex set" and Phi :: "complex poly"
  assumes sfE: "Subfield E" and sfF: "Subfield F" and FE: "F \<subseteq> E"
    and Phi: "Phi \<in> poly_over F"
    and split: "splitting_field E Phi K"
    and stable: "\<And>\<sigma>. \<sigma> \<in> field_auto K F \<Longrightarrow> \<sigma> ` E = E"
    and solvK: "Group.solvable (field_auto K F) (compose K) (identity K)"
  shows "Group.solvable (field_auto E F) (compose E) (identity E)"
proof -
  have K: "Subfield K"
    using splitting_field_subfield[OF split]
    by (simp add: complex_subfield_iff_subfield)
  have EK: "E \<subseteq> K"
    by (rule splitting_field_base_subset[OF split])
  \<comment> \<open>The splitting-field restriction theorem supplies surjectivity, including both image
    inclusions and the finite extension argument.\<close>
  have onto_named: "galois_restriction K E F ` field_auto K F = field_auto E F"
    by (rule galois_restriction_image_of_splitting_field[OF split sfE sfF FE Phi stable])
  have onto: "(\<lambda>\<sigma>. restrict \<sigma> E) ` field_auto K F = field_auto E F"
    using onto_named by (simp add: galois_restriction_def)
  show ?thesis
    by (rule galois_solvable_descends[OF K sfE sfF FE EK stable onto solvK])
qed

